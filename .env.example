# =============================================================================
# MASSALIA — Variables d'environnement
# =============================================================================
# Copier ce fichier en ".env.local" pour le développement local.
# En production (Vercel), définir ces variables dans le tableau de bord Vercel
# ou via `vercel env add`.
# =============================================================================

# SITE_URL — Source de vérité unique pour :
#   • <link rel="canonical" href="...">
#   • og:url dans les balises Open Graph
#   • Les URLs dans sitemap.xml
#   • La directive Sitemap: dans robots.txt
#
# ⚠ Ne jamais laisser de slash final.
# Valeur de production :
SITE_URL=https://massalia.vercel.app
